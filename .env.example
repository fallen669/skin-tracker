# Скопируй в .env и заполни.

# Канал в Discord -> Настройки -> Интеграции -> Вебхуки -> Создать вебхук -> Копировать URL
DISCORD_WEBHOOK=

# Период цикла в минутах. Меньше 5 бессмысленно: Skinport кэширует ответ на 5 мин.
INTERVAL_MINUTES=10

# Ценовой коридор и минимальная ликвидность
MIN_PRICE_USD=5
MAX_PRICE_USD=400
MIN_LISTINGS=8

# Комиссии продавца (доля). ПРОВЕРЬ ПОД СВОЙ АККАУНТ — у Skinport она падает с оборотом.
FEE_SKINPORT=0.12
FEE_WAXPEER=0.06
FEE_STEAM=0.15

# Порог маржи для алерта
MIN_MARGIN_PCT=8

# Не повторять один и тот же предмет чаще, чем раз в N часов
ALERT_COOLDOWN_HOURS=12

# Steam — только справочно (деньги из кошелька Steam не выводятся).
# Жёсткие рейт-лимиты, поэтому по умолчанию выключен.
STEAM_ENABLED=false
STEAM_ITEMS_PER_CYCLE=40
STEAM_DELAY_MS=3500
STEAM_CURRENCY=1

# Минимальная абсолютная прибыль на предмет, USD
MIN_NET_PROFIT_USD=5

# Отсев несравнимых котировок (трейд-лок / фазы / выбросы)
MAX_LOCK_SKEW=1.25
MIN_ANCHOR_RATIO=0.55
MAX_ANCHOR_RATIO=1.80

# Включить стикеры, капсулы, граффити (по умолчанию отключены)
INCLUDE_NON_WEAPONS=false
